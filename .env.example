# Copia a .env.local (cp .env.example .env.local) y ejecuta: npm start
# Modo fixture: funciona sin credenciales de Reap; el pago es una simulación local.
APP_MODE=fixture
APP_ORIGIN=http://localhost:3000

# Cuentas de demo: usuarios "solicitante" y "responsable" con estas contraseñas.
# Valores de ejemplo para uso local; cámbialos si lo prefieres (mínimo 16 caracteres, distintos entre sí).
DEMO_EMAIL=demo@example.com
DEMO_REQUESTER_PASSWORD=demo-solicitante-2026
DEMO_APPROVER_PASSWORD=demo-responsable-2026

# Solo para probar contra el sandbox de Reap (cada quien con sus propias credenciales):
# APP_MODE=sandbox
# APP_ORIGIN=https://localhost:3443   (requiere TLS local: npm run tls)
# REAP_BASE_URL=
# REAP_VERSION=
# REAP_API_KEY=
# REAP_ENROLLMENT_ID=   (opcional si ya tienes un enrollment)
# Nunca incluyas datos de tarjeta, OTP ni claves reales en este archivo.
